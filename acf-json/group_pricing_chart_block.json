            "instructions": "Header label for the first product column (e.g. Plixer Scrutinizer)",
            "required": 1,
            "default_value": "",
            "placeholder": "Plixer Scrutinizer",
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_pc_col2_name",
            "label": "Column 2 Name",
