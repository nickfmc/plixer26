            "required": 0,
            "choices": { "button": "Button", "price_text": "Price Text" },
            "default_value": "button",
            "allow_null": 0,
            "multiple": 0,
            "ui": 0,
            "wrapper": { "width": "50", "class": "", "id": "" }
